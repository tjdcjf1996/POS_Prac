{
  "name": "posprac",
  "version": "1.0.0",
  "description": "POS 개발환경을 학습하기 위한 시뮬레이션",
  "private": true,
  "workspaces": [
    "package/*"
  ],
  "scripts": {
    "build:all": "npm run build --workspaces",
    "dev:delivery": "npm run dev --workspace=@posprac/delivery-server",
    "dev:edge": "npm run dev --workspace=@posprac/edge-bridge",
    "dev:client": "npm run dev --workspace=@posprac/client",
    "dev:pos": "npm run dev --workspace=@posprac/pos-main"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
